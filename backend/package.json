{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "metagraph-mcp",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/mcp/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:watch": "tsx watch src/mcp/server.ts",
    "server": "tsx src/server/app.ts",
    "server:watch": "tsx watch src/server/app.ts",
    "cli": "tsx src/cli/index.ts",
    "cli:watch": "tsx watch src/cli/index.ts",
    "sync": "tsx src/sync/index.ts once",
    "sync:watch": "tsx src/sync/index.ts watch"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@modelcontextprotocol/sdk": "1.0.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}