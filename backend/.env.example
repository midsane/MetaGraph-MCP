# Which LLM backend every text-generation and embedding call routes through
# (Scribe agent, HyDE, agent runtime, vector-store embeddings). See src/llm/.
# "gemini" (default) or "openrouter".
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# --- OpenRouter (only needed when LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Must return (or support truncating to, via the `dimensions` param) the same
# 768-dim vectors the Qdrant collection was created with under Gemini -
# otherwise embedding calls will fail their dimension check. Re-index the
# catalog if you switch to a model with a different native dimension.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

PORT=3000
NODE_ENV=development

# MetaGraph's own catalog store: tables, columns, PII tags, sync watermark.
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5434
CATALOG_DB_USER=admin
CATALOG_DB_PASSWORD=password123
CATALOG_DB_NAME=metagraph

# External/company database that owns the live business data (read-only).
BUSINESS_DB_HOST=localhost
BUSINESS_DB_PORT=5433
BUSINESS_DB_USER=business_admin
BUSINESS_DB_PASSWORD=business_password123
BUSINESS_DB_NAME=business
BUSINESS_DB_SCHEMA=target_db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

QDRANT_URL=http://localhost:6333

# How long the event listener waits after the last notification before
# running syncUp(), so a burst of DDL statements collapses into one sync.
SYNC_DEBOUNCE_MS=1500
